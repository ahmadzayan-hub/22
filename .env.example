# ALKAHTANI OS — no hardcoded secrets; every integration is env-keyed.
# Core
OPERATOR_TOKEN=change-me                 # single-operator bearer token
DATABASE_URL=postgres://os:os@localhost:5432/os
VAULT_PATH=./vault

# Local LLM stack
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b                       # local stand-in for qwen3.6-hermes
EMBED_MODEL=bge-m3                       # 1024-dim — must match embeddings vector(1024)
WHISPER_URL=http://localhost:8001/v1/audio/transcriptions

# Frontend
NEXT_PUBLIC_API=http://localhost:8080

# MCP connectors (empty ⇒ connector reports offline/unconfigured, never crashes)
ATTIO_API_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SQUARE_ACCESS_TOKEN=
WHOP_API_KEY=
PAVA_API_KEY=
SLACK_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
WHATSAPP_TOKEN=
MANYCHAT_API_KEY=
NOTION_TOKEN=
GOHIGHLEVEL_TOKEN=
