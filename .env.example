# ALKAHTANI OS — no hardcoded secrets; every integration is env-keyed.
# Core
OPERATOR_TOKEN=change-me                 # single-operator bearer token
DATABASE_URL=postgres://os:os@localhost:5432/os
VAULT_PATH=./vault

# LLM — Grok API (xAI) is the primary provider
XAI_API_KEY=                             # required for Grok; empty -> falls back to local Ollama
GROK_MODEL=grok-4                        # e.g. grok-4 (default) or a cheaper/faster variant
XAI_BASE_URL=https://api.x.ai/v1

# Local sidecars (embeddings + fallback LLM + voice)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b                       # fallback model when Grok is unreachable/unset
EMBED_MODEL=bge-m3                       # 1024-dim — must match embeddings vector(1024); stays local
WHISPER_URL=http://localhost:8001/v1/audio/transcriptions

# Frontend
NEXT_PUBLIC_API=http://localhost:8080

# Alerts — optional; empty ⇒ incidents are still recorded in the DB, just not pushed anywhere
ALERT_WEBHOOK_URL=                       # Slack/Discord-style incoming webhook (POST {"text": "..."})

# Backups (scripts/backup_db.sh)
BACKUP_DIR=./backups                     # gitignored; pg_dump output lands here
BACKUP_RETAIN=14                         # keep this many most-recent dumps, prune the rest

# MCP connectors (empty ⇒ connector reports offline/unconfigured, never crashes)
ATTIO_API_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SQUARE_ACCESS_TOKEN=
WHOP_API_KEY=
PAVA_API_KEY=
SLACK_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
WHATSAPP_TOKEN=
MANYCHAT_API_KEY=
NOTION_TOKEN=
GOHIGHLEVEL_TOKEN=
